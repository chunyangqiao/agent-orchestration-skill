{
  "name": "agent-orchestration",
  "version": "2.1.0",
  "description": "A portable multi-agent orchestration skill for Codex, Claude Code, and Kimi Code, with configurable roles and models.",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "format": "oxfmt --write \"{skills/agent-orchestration/scripts,tests}/**/*.mjs\"",
    "format:check": "oxfmt --check \"{skills/agent-orchestration/scripts,tests}/**/*.mjs\"",
    "lint-staged": "lint-staged",
    "test": "node --test tests/*.test.mjs",
    "configure": "node skills/agent-orchestration/scripts/configure.mjs",
    "setup": "node skills/agent-orchestration/scripts/configure.mjs setup",
    "configure:bootstrap": "node skills/agent-orchestration/scripts/configure.mjs bootstrap",
    "configure:init": "node skills/agent-orchestration/scripts/configure.mjs init",
    "configure:render": "node skills/agent-orchestration/scripts/configure.mjs render",
    "configure:install": "node skills/agent-orchestration/scripts/configure.mjs install",
    "configure:check": "node skills/agent-orchestration/scripts/configure.mjs check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2"
}
